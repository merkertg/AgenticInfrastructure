# Optional local settings. Do not overwrite an existing .env.
APP_NAME=agentic-infrastructure
APP_ENV=development
APP_DEBUG=false
# Memory routes stay disabled (503) until a local lab database is configured.
# APP_DATABASE_URL=postgresql+psycopg://agentic@127.0.0.1:55435/agentic_lab
# Compose lab: secrets are files from `python -m scripts.lab_secrets`, never
# variables here. Put the folder outside protected macOS folders if needed.
# AGENTIC_SECRETS_DIR=./var/secrets
# APP_PORT=8005
# POSTGRES_PORT=55436
# Alternatively the API can read its database URL from a file.
# APP_DATABASE_URL_FILE=/run/secrets/app_database_url
