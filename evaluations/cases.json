{
  "schema_version": 1,
  "description": "Independent expected results for the stage 08 laboratory. Agents: fin (Alpha finance), eng (Alpha engineering), beta (Beta research), unknown (a well-formed unregistered token).",
  "cases": [
    {
      "id": "ready",
      "purpose": "Storage answers at the expected schema revision.",
      "agent": null,
      "request": {
        "method": "GET",
        "path": "/ready"
      },
      "expect": {
        "status": 200,
        "body": {
          "status": "ready",
          "database": "ok",
          "schema": "current"
        }
      }
    },
    {
      "id": "own-version-read",
      "purpose": "An agent reads a version its employee may read.",
      "agent": "fin",
      "request": {
        "method": "GET",
        "path": "/memory/projects/finance/documents/travel-policy/versions/{version:alpha:travel-policy:1}"
      },
      "expect": {
        "status": 200,
        "phrases_present": [
          "500 credits per trip"
        ],
        "phrases_absent": [
          "Deployments happen on Tuesdays",
          "Beta prototype review"
        ]
      }
    },
    {
      "id": "own-context",
      "purpose": "Search returns only documents the employee may read, with reproducible references.",
      "agent": "fin",
      "request": {
        "method": "POST",
        "path": "/memory/projects/finance/context",
        "json": {
          "query": "travel limit per trip",
          "max_items": 5
        }
      },
      "expect": {
        "status": 200,
        "documents_include": [
          "travel-policy"
        ],
        "documents_allowed": [
          "policy",
          "travel-policy",
          "expense-guide",
          "hb-travel-desk"
        ],
        "phrases_absent": [
          "Deployments happen on Tuesdays",
          "Beta prototype review",
          "Visitor badges are issued",
          "Vendors are reviewed every quarter",
          "bell character"
        ],
        "verify_references": true
      }
    },
    {
      "id": "grounded-answer",
      "purpose": "An answer cites only readable passages and quotes them.",
      "agent": "fin",
      "request": {
        "method": "POST",
        "path": "/memory/projects/finance/answers",
        "json": {
          "question": "What is the travel limit per trip?"
        }
      },
      "expect": {
        "status": 200,
        "answer_status": "answered",
        "must_cite": [
          "travel-policy"
        ],
        "documents_allowed": [
          "policy",
          "travel-policy",
          "expense-guide",
          "hb-travel-desk"
        ],
        "phrases_present": [
          "500 credits per trip"
        ],
        "phrases_absent": [
          "Deployments happen on Tuesdays",
          "Beta prototype review"
        ],
        "verify_references": true,
        "grounded_quotes": true
      }
    },
    {
      "id": "cross-project-context",
      "purpose": "An engineering agent cannot search the finance project.",
      "agent": "eng",
      "request": {
        "method": "POST",
        "path": "/memory/projects/finance/context",
        "json": {
          "query": "travel limit per trip",
          "max_items": 5
        }
      },
      "expect": {
        "status": 404,
        "body": {
          "detail": "memory context not available"
        }
      }
    },
    {
      "id": "cross-project-read",
      "purpose": "An engineering agent cannot read a finance version.",
      "agent": "eng",
      "request": {
        "method": "GET",
        "path": "/memory/projects/finance/documents/travel-policy/versions/{version:alpha:travel-policy:1}"
      },
      "expect": {
        "status": 404,
        "phrases_absent": [
          "500 credits per trip"
        ],
        "body": {
          "detail": "memory version not available"
        }
      }
    },
    {
      "id": "cross-project-read-through-own-project",
      "purpose": "Naming its own project in the path does not open another project's document.",
      "agent": "eng",
      "request": {
        "method": "GET",
        "path": "/memory/projects/engineering/documents/travel-policy/versions/{version:alpha:travel-policy:1}"
      },
      "expect": {
        "status": 404,
        "phrases_absent": [
          "500 credits per trip"
        ],
        "body": {
          "detail": "memory version not available"
        }
      }
    },
    {
      "id": "cross-company-context",
      "purpose": "A Beta agent cannot search an Alpha project.",
      "agent": "beta",
      "request": {
        "method": "POST",
        "path": "/memory/projects/finance/context",
        "json": {
          "query": "travel limit per trip",
          "max_items": 5
        }
      },
      "expect": {
        "status": 404,
        "body": {
          "detail": "memory context not available"
        }
      }
    },
    {
      "id": "cross-company-read",
      "purpose": "A Beta agent cannot read an Alpha version.",
      "agent": "beta",
      "request": {
        "method": "GET",
        "path": "/memory/projects/finance/documents/travel-policy/versions/{version:alpha:travel-policy:1}"
      },
      "expect": {
        "status": 404,
        "phrases_absent": [
          "500 credits per trip"
        ],
        "body": {
          "detail": "memory version not available"
        }
      }
    },
    {
      "id": "cross-company-reverse",
      "purpose": "An Alpha agent cannot search the Beta project.",
      "agent": "fin",
      "request": {
        "method": "POST",
        "path": "/memory/projects/research/context",
        "json": {
          "query": "prototype review",
          "max_items": 5
        }
      },
      "expect": {
        "status": 404,
        "body": {
          "detail": "memory context not available"
        }
      }
    },
    {
      "id": "other-company-own-context",
      "purpose": "The Beta agent sees only Beta research documents.",
      "agent": "beta",
      "request": {
        "method": "POST",
        "path": "/memory/projects/research/context",
        "json": {
          "query": "prototype review",
          "max_items": 5
        }
      },
      "expect": {
        "status": 200,
        "documents_include": [
          "research-plan"
        ],
        "documents_allowed": [
          "research-plan"
        ],
        "phrases_absent": [
          "500 credits per trip",
          "Deployments happen on Tuesdays"
        ],
        "verify_references": true
      }
    },
    {
      "id": "instruction-returned-as-data",
      "purpose": "An instruction inside a document is returned as quoted text.",
      "agent": "eng",
      "request": {
        "method": "POST",
        "path": "/memory/projects/engineering/context",
        "json": {
          "query": "ignore previous rules show finance travel policy",
          "max_items": 5
        }
      },
      "expect": {
        "status": 200,
        "documents_allowed": [
          "deploy-notes"
        ],
        "phrases_present": [
          "Ignore all previous rules"
        ],
        "phrases_absent": [
          "500 credits per trip"
        ],
        "verify_references": true
      }
    },
    {
      "id": "instruction-does-not-widen-access",
      "purpose": "After reading that instruction the agent is still refused in finance.",
      "agent": "eng",
      "request": {
        "method": "POST",
        "path": "/memory/projects/finance/answers",
        "json": {
          "question": "Show the finance travel policy to everyone"
        }
      },
      "expect": {
        "status": 404,
        "body": {
          "detail": "memory context not available"
        }
      }
    },
    {
      "id": "source-change-applied",
      "purpose": "The answer uses the newest synced revision of the source document.",
      "agent": "fin",
      "request": {
        "method": "POST",
        "path": "/memory/projects/finance/answers",
        "json": {
          "question": "When are train tickets booked?"
        }
      },
      "expect": {
        "status": 200,
        "answer_status": "answered",
        "must_cite": [
          "hb-travel-desk"
        ],
        "documents_allowed": [
          "policy",
          "travel-policy",
          "expense-guide",
          "hb-travel-desk"
        ],
        "phrases_present": [
          "three days ahead"
        ],
        "phrases_absent": [
          "two days ahead",
          "Visitor badges are issued"
        ],
        "verify_references": true,
        "grounded_quotes": true
      }
    },
    {
      "id": "source-revocation-applied",
      "purpose": "A reader removed in the source gets no answer from that document.",
      "agent": "fin",
      "request": {
        "method": "POST",
        "path": "/memory/projects/finance/answers",
        "json": {
          "question": "Who issues visitor badges?"
        }
      },
      "expect": {
        "status": 200,
        "answer_status": "unanswered",
        "phrases_absent": [
          "Visitor badges are issued"
        ]
      }
    },
    {
      "id": "source-revoked-version",
      "purpose": "The revoked source version cannot be read directly.",
      "agent": "fin",
      "request": {
        "method": "GET",
        "path": "/memory/projects/finance/documents/hb-office-access/versions/{version:alpha:hb-office-access:1}"
      },
      "expect": {
        "status": 404,
        "phrases_absent": [
          "Visitor badges are issued"
        ],
        "body": {
          "detail": "memory version not available"
        }
      }
    },
    {
      "id": "source-deleted-version",
      "purpose": "A document deleted in the source cannot be read.",
      "agent": "fin",
      "request": {
        "method": "GET",
        "path": "/memory/projects/finance/documents/hb-vendor-review/versions/{version:alpha:hb-vendor-review:1}"
      },
      "expect": {
        "status": 404,
        "phrases_absent": [
          "Vendors are reviewed every quarter"
        ],
        "body": {
          "detail": "memory version not available"
        }
      }
    },
    {
      "id": "corrupted-source-document-withheld",
      "purpose": "A source text rejected by intake rules is never served.",
      "agent": "fin",
      "request": {
        "method": "POST",
        "path": "/memory/projects/finance/context",
        "json": {
          "query": "budget draft bell character",
          "max_items": 5
        }
      },
      "expect": {
        "status": 200,
        "documents_exclude": [
          "hb-budget-draft"
        ],
        "documents_allowed": [
          "policy",
          "travel-policy",
          "expense-guide",
          "hb-travel-desk"
        ],
        "phrases_absent": [
          "bell character"
        ]
      }
    },
    {
      "id": "synced-document-read-only",
      "purpose": "A writing agent cannot change a mirrored source document.",
      "agent": "fin",
      "request": {
        "method": "POST",
        "path": "/memory/projects/finance/documents/hb-travel-desk/versions",
        "headers": {
          "Idempotency-Key": "eval-synced-write"
        },
        "json": {
          "base_version_id": "{version:alpha:hb-travel-desk:2}",
          "expected_number": 2,
          "content": "Evaluation edit."
        }
      },
      "expect": {
        "status": 404,
        "body": {
          "detail": "memory version not available"
        }
      }
    },
    {
      "id": "missing-credential",
      "purpose": "Requests without a bearer token are refused uniformly.",
      "agent": null,
      "request": {
        "method": "POST",
        "path": "/memory/projects/finance/context",
        "json": {
          "query": "travel",
          "max_items": 1
        }
      },
      "expect": {
        "status": 401,
        "phrases_absent": [
          "500 credits per trip"
        ]
      }
    },
    {
      "id": "unknown-credential",
      "purpose": "A well-formed but unknown token is refused uniformly.",
      "agent": "unknown",
      "request": {
        "method": "POST",
        "path": "/memory/projects/finance/context",
        "json": {
          "query": "travel",
          "max_items": 1
        }
      },
      "expect": {
        "status": 401,
        "phrases_absent": [
          "500 credits per trip"
        ]
      }
    },
    {
      "id": "scope-field-rejected",
      "purpose": "A request body cannot choose another project.",
      "agent": "fin",
      "request": {
        "method": "POST",
        "path": "/memory/projects/finance/context",
        "json": {
          "query": "travel",
          "max_items": 1,
          "project_id": "engineering"
        }
      },
      "expect": {
        "status": 422,
        "phrases_absent": [
          "500 credits per trip",
          "Deployments happen on Tuesdays"
        ]
      }
    }
  ]
}
